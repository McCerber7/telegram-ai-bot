# === Обязательно ===
# Токен бота от @BotFather в Telegram
BOT_TOKEN=

# === Выбор ИИ-провайдера ===
# claude | mistral
PROVIDER=claude

# --- Claude (ключ: https://console.anthropic.com/settings/keys) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Глубина размышлений: low | medium | high | xhigh | max
# low — быстрее и дешевле, для автоответов обычно достаточно
CLAUDE_EFFORT=low
# Автопереключение на запасную модель при отказе по политике безопасности
USE_FALLBACKS=true

# --- Mistral (ключ: https://console.mistral.ai/api-keys) ---
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TEMPERATURE=0.7

# === Память и лимиты ===
# Сколько последних сообщений хранить в истории одного чата
HISTORY_LIMIT=20
# Максимальная длина ответа модели в токенах
MAX_TOKENS=4096

# === Отладка ===
# 1 — отвечать эхом, без обращения к ИИ (проверка связи с Telegram)
# ECHO_MODE=1
